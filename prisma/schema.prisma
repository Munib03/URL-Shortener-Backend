generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model user {
  id String @id @default(uuid())
  firstName String @db.VarChar(10) 
  lastName String @db.VarChar(10)
  email String @unique
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}